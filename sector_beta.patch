+    def sector_betas(self, di, g, sec):
+        """Amendment 7: each candidate's Dimson beta (lag 0 + lag 1, as in
+        dimson_beta) to its own GICS sector, whose daily return is the
+        equal-weighted mean of that sector's candidates. Uses the trailing
+        SECTOR_BETA_DAYS rows of self.R_hist up to YESTERDAY (row
+        hist_off + di - 1; row hist_off + di is today), so nothing from the
+        formation day enters. Clipped to SECTOR_BETA_CLIP; 1.0 for a name with
+        fewer than SECTOR_BETA_MIN_DAYS usable days. Returns one weight per
+        perm (1.0 off the candidate list)."""
+        w = np.ones(len(self.perms))
+        today = self.hist_off + di
+        win = self.R_hist[max(0, today - SECTOR_BETA_DAYS):today]
+        pi = g["pi"].values
+        for s in np.unique(sec):
+            cols = pi[sec == s]
+            Y = win[:, cols]
+            ok = np.isfinite(Y)
+            n = ok.sum(axis=1)
+            with np.errstate(invalid="ignore"):            # a day with no returns -> nan
+                m = np.where(ok, Y, 0.0).sum(axis=1) / n
+            for j, c in enumerate(cols):
+                y = Y[:, j]
+                use = np.isfinite(y[1:]) & np.isfinite(m[1:]) & np.isfinite(m[:-1])
+                if use.sum() < SECTOR_BETA_MIN_DAYS:
+                    continue
+                X = np.column_stack([np.ones(use.sum()), m[1:][use], m[:-1][use]])
+                coef, *_ = np.linalg.lstsq(X, y[1:][use], rcond=None)
+                w[c] = np.clip(coef[1] + coef[2], *SECTOR_BETA_CLIP)
+        return w
+
