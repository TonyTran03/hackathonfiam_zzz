+def load_return_hist(days, perms, n_before):
+    """Amendment 7 only: daily returns for the n_before trading days before
+    the window plus the window itself, same columns as load_inputs' R. Kept
+    apart from R so no other part of the engine sees the extra history.
+    Returns the matrix and the row of the window's first day."""
+    cal = pd.read_parquet(F.DATA / "calendar.parquet")
+    lo, hi = days["date"].iloc[0], days["date"].iloc[-1]
+    before = list(cal.loc[cal["date"] < lo, "date"].sort_values().iloc[-n_before:])
+    dsf = pd.read_parquet(F.DSF_PARQUET)
+    dsf = dsf[dsf["permno"].isin(perms) & (dsf["date"] >= before[0]) & (dsf["date"] <= hi)]
+    R = (dsf.pivot(index="date", columns="permno", values="daily_return")
+            .reindex(index=before + list(days["date"]), columns=perms))
+    return R.values, len(before)
